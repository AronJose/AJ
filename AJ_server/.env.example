# Copy to .env.local in AJ_server for local API development.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# Comma-separated production browser origins. Local CRA origins are explicitly allowed in code.
CORS_ORIGIN=https://aronjose.in,https://www.aronjose.in
# Optional model override
# GEMINI_MODEL=gemini-3.5-flash
